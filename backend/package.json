{
  "name": "netzero-backend",
  "version": "0.1.0",
  "description": "NetZero API: Lambda + API Gateway + MongoDB Atlas",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "deploy": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "logs": "serverless logs --stage dev --tail -f",
    "seed": "tsx scripts/seed.ts",
    "explain:balances": "tsx scripts/explain-balances.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1162.0",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/client-ssm": "^3.1162.0",
    "@aws-sdk/s3-presigned-post": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
